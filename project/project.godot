; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Sandhawk"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

GameState="*res://game/autoload/game_state.gd"
MissionManager="*res://game/autoload/mission_manager.gd"
AudioManager="*res://game/autoload/audio_manager.gd"
Vfx="*res://vfx/vfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.835294, 0.713726, 0.517647, 1)
